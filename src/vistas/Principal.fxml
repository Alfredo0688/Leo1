<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vistas.PrincipalController">
   <children>
      <VBox id="vbox_alta_instituto" alignment="TOP_CENTER" layoutX="53.0" layoutY="79.0" prefHeight="122.0" prefWidth="495.0">
         <children>
            <Label text="Alta de Instituto" />
            <HBox alignment="CENTER" prefHeight="51.0" prefWidth="264.0">
               <children>
                  <Label prefHeight="17.0" prefWidth="93.0" text="Denominación" />
                  <TextField fx:id="txt_denominacion" prefHeight="25.0" prefWidth="220.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="45.0" prefWidth="495.0">
               <children>
                  <Button fx:id="btn_agregar_instituto" mnemonicParsing="false" onAction="#agregarInstituto" prefHeight="25.0" prefWidth="79.0" text="Agregar" />
               </children>
            </HBox>
         </children>
      </VBox>
      <Label alignment="CENTER" layoutX="41.0" layoutY="24.0" prefHeight="17.0" prefWidth="519.0" text="Bienvenidos/as" textAlignment="JUSTIFY" textFill="WHITE">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <HBox layoutX="41.0" layoutY="201.0" prefHeight="45.0" prefWidth="519.0" />
      <VBox id="vbox_buscar_instituto" alignment="CENTER" layoutX="53.0" layoutY="246.0" prefHeight="122.0" prefWidth="495.0">
         <children>
            <HBox alignment="CENTER" prefHeight="43.0" prefWidth="495.0">
               <children>
                  <Label prefHeight="17.0" prefWidth="163.0" text="Buscar Instituto" />
                  <ComboBox fx:id="cbb_institutos" onAction="#seleccionarInstituto" prefWidth="150.0" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
